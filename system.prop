# Google Lens
ro.com.google.lens.oem_camera_package=com.android.camera

# Framework allowlists
persist.vendor.camera.privapp.list=com.android.camera
vendor.camera.aux.packagelist=com.android.camera

# Camera Hal identification
ro.hardware.camera=xiaomi

# spoof MIUI version to HyperOS V1.0 to unlock newer features
ro.miui.ui.version.code=816
ro.miui.ui.version.name=V816

# Enable advanced features
persist.vendor.camera.enableAdvanceFeatures=0x3E7

# MiuiCamera
ro.miui.notch=1

# Force Codec2 path
debug.stagefright.omx_default_rank=0
debug.stagefright.c2-atomic=true
media.stagefright.enable-c2=1
media.stagefright.enable-fma=1

# Disable legacy OMX components if they conflict
vendor.media.omx.disable=1

# MiuiCamera
ro.miui.build.region=in
ro.product.mod_device=_global
ro.boot.camera.config=_pro

# Disable Vidhance/EIS to fix video recording crash
persist.camera.eis.enable=0
persist.vendor.camera.eis.enable=0
persist.camera.is_type=0
persist.vendor.camera.is_type=0

# Disable bad vendor parallel session pipelines that freeze video modes
persist.vendor.camera.algo.enable=0
persist.vendor.camera.mialgo.caps=0
persist.vendor.camera.parallel.disable=1

# Kill TikTok/Mimoji tracking telemetry causing short video feature crashes
persist.vendor.camera.shortvideo.cn=0
persist.vendor.camera.vlog.disable=1
persist.vendor.camera.mimoji.cache=0

# Standardize AOSP media recorder layer mappings
persist.vendor.camera.privapp.dump=0
ro.media.recorder-max-base-layer=8
