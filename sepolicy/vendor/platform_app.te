allow platform_app vendor_hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;

allow platform_app cameraserver_service:service_manager find;
allow platform_app app_data_file:dir create_dir_perms;
allow platform_app app_data_file:file create_file_perms;

allow platform_app system_data_file:dir search;

binder_call(platform_app, cameraserver)
binder_use(platform_app)
# MIUI Camera
typeattribute platform_app hal_camera_client;
typeattribute platform_app hal_graphics_allocator_client;

# Allow platform_app to read vendor camera properties
get_prop(platform_app, vendor_camera_prop)
get_prop(platform_app, vendor_camera_sensor_prop)
get_prop(platform_app, vendor_display_type_prop)
get_prop(platform_app, vendor_us_proximity_prop)

allow platform_app {
    vendor_hal_camerapostproc_xiaomi_hwservice
    hal_misys_hwservice
}:hwservice_manager find;

allow platform_app {
    DisplayFeatureControl
    miui_multi_display
    perfshielder
    ProcessManager
}:service_manager find;

binder_call(platform_app, hal_camera_default)

hwbinder_use(platform_app)

allow platform_app hal_xiaomi_camera_hwservice:hwservice_manager find;

allow platform_app app_data_file:file execute;

allow platform_app media_rw_data_file:dir create_dir_perms;
allow platform_app media_rw_data_file:file create_file_perms;

r_dir_file(platform_app, vendor_camera_data_file)

get_prop(platform_app, vendor_display_prop)
get_prop(platform_app, vendor_audio_prop)
get_prop(platform_app, vendor_camera_prop)
allow platform_app proc_stat:file read;
typeattribute platform_app halclientdomain;
typeattribute platform_app vendor_hal_camerapostproc_xiaomi_client;
allow platform_app { vendor_hal_camerapostproc_xiaomi_hwservice hal_misys_hwservice }:hwservice_manager find;
